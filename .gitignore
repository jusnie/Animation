.venv/
__pycache__/
*.pyc

# intermediates: rebuild with ./render.sh
render/qa/
render/_vo_tmp.wav

# synthesised beds are regenerated by tools/make_sfx.py
audio/sfx/
audio/music/

# vendored skill data is committed; its scratch output is not
.claude/skills/*/scripts/**/__pycache__/

# tasteskill build state (per-build, never committed)
.taste-skill/
**/.taste-skill/

# runtime deps of the stickman skill (npm install in that folder)
.claude/skills/directing-stickman-videos/node_modules/
